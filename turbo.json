{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "**/.env.*local",
        "**/.env"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ],
            "env": [
                "NEXT_PUBLIC_*",
                "DATABASE_URL",
                "BETTER_AUTH_SECRET",
                "BETTER_AUTH_URL",
                "STRIPE_SECRET_KEY",
                "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
                "OPENAI_API_KEY",
                "INTERNAL_BACKEND_URL"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "type-check": {
            "dependsOn": [
                "^build"
            ]
        },
        "clean": {
            "cache": false
        }
    }
}